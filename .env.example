# INF2003 backend configuration example.
#
# Copy this file to `.env` in the repository root and replace the placeholder
# values for your machine. `.env` is machine-local and must never be committed.
#
# Real process environment variables take precedence over values in `.env`.
#
# MariaDB settings.
MARIADB_HOST=127.0.0.1
# The example port 3307 is a local value only.
# Use the port from your own MariaDB configuration.
MARIADB_PORT=3307
MARIADB_USER=replace_with_local_username
MARIADB_PASSWORD=replace_with_local_password
MARIADB_DATABASE=inf2003_db_mariadb

# MongoDB settings. These key names are shared with the MongoDB scripts in the
# sibling `database/` folder, so both must keep the same values while both exist.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=inf2003_mongodb
